# Caddyfile configuration for server deployment
# Implements ALTCHA PoW captcha -> Discord OAuth2 auth policy flow for /verify and /dashboard,
# reverse proxies to DPP C++ backend (ports 8081 & 8442), and handles 404 fallbacks.

{
    order altcha_verify before respond
    order authenticate before respond
    order authorize before respond

    # Top-Level Security App Configuration (caddy-security)
    security {
        oauth identity provider discord {
            realm discord
            driver discord
            client_id "{$DISCORD_CLIENT_ID}"
            client_secret "{$DISCORD_CLIENT_SECRET}"
            scopes identify email
        }

        authentication portal myportal {
            crypto key sign-verify "{$JWT_SECRET:change-me-jwt-secret}"
            enable identity provider discord
            cookie domain wenlock.zapto.org
        }

        authorization policy verify_policy {
            set auth url /auth
            crypto key verify "{$JWT_SECRET:change-me-jwt-secret}"
            set token sources cookie header
            allow roles authp/user authp/admin
        }
    }
}

# 1. HTTP (Port 80) -> HTTPS Redirect
http://wenlock.zapto.org {
    redir https://{host}{uri} permanent
}

# 2. HTTPS (Port 443) Site Block & TLS Policy
https://wenlock.zapto.org {
    tls {
        protocols tls1.2 tls1.3
    }

    # ALTCHA PoW Captcha Challenge Endpoint
    handle /altcha/challenge {
        altcha_challenge {
            hmac_key "{$ALTCHA_HMAC_KEY:change-me-secret-key}"
        }
    }

    # Auth Portal Routes (caddy-security)
    handle /auth* {
        authenticate with myportal
    }

    # Discord Bot Auth Query Endpoint
    handle /auth/check/* {
        reverse_proxy {$SERVER_IP:192.168.1.100}:8081
    }

    # /verify Route: ALTCHA -> OAuth -> serves verified.html
    handle /verify/* {
        altcha_verify {
            hmac_key "{$ALTCHA_HMAC_KEY:change-me-secret-key}"
        }
        authorize with verify_policy

        root * /var/www/html
        rewrite * /verified.html
        file_server
    }

    # /dashboard Route: ALTCHA -> OAuth -> serves dashboard.html
    handle /dashboard/* {
        altcha_verify {
            hmac_key "{$ALTCHA_HMAC_KEY:change-me-secret-key}"
        }
        authorize with verify_policy

        root * /var/www/html
        rewrite * /dashboard.html
        file_server
    }

    # /appeal Route: OAuth -> serves appeal.html
    handle /appeal* {
        authorize with verify_policy

        root * /var/www/html
        rewrite * /appeal.html
        file_server
    }

    # DPP C++ Dashboard API (Port 8081)
    handle /api/* {
        reverse_proxy {$SERVER_IP:192.168.1.100}:8081
    }

    # Secondary Bot & WebSocket Gateway Proxy (Port 8442 mapped from HTTPS 443)
    handle /bot/* {
        uri strip_prefix /bot
        reverse_proxy https://{$SERVER_IP:192.168.1.100}:8442 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }

    handle /ws/* {
        reverse_proxy https://{$SERVER_IP:192.168.1.100}:8442 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }

    # Unknown / Fallback: Serves 404.html
    handle {
        root * /var/www/html
        try_files {path} /404.html
        file_server
    }

    handle_errors {
        root * /var/www/html
        rewrite * /404.html
        file_server
    }
}
